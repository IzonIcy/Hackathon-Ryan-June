# ──────────────────────────────────────────────
# FabOps Sentinel — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# The AI vision system REQUIRES at minimum:
#   OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL
#
# Twilio SMS alerts are optional (delete if not needed)
# ──────────────────────────────────────────────

# === AI Vision (REQUIRED) ===
# Your OpenAI-compatible API key (or EAON, Groq, etc.)
OPENAI_API_KEY=sk-your-key-here
# Base URL for the API (OpenAI: https://api.openai.com/v1, EAON: https://api.eaon.dev/v1)
OPENAI_BASE_URL=https://api.eaon.dev/v1
# Model to use (e.g., gpt-4o-mini, gemini-3.1-flash-lite, etc.)
OPENAI_MODEL=gemini-3.1-flash-lite

# === Twilio SMS Alerts (OPTIONAL) ===
# Get these at https://console.twilio.com
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_API_KEY_SID=your_api_key_sid
# TWILIO_API_KEY_SECRET=your_api_key_secret
# TWILIO_PHONE_NUMBER=+12345678900
# ALERT_PHONE_NUMBER=+12345678900
