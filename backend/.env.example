# ──────────────────────────────────────────────
# FabOps Sentinel — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# The AI vision system needs an OpenAI-compatible endpoint: OPENAI_BASE_URL
# and OPENAI_MODEL. A hosted provider also needs OPENAI_API_KEY; a local one
# (Ollama) does not.
#
# Twilio SMS alerts are optional (delete if not needed)
# ──────────────────────────────────────────────

# === API Auth (RECOMMENDED) ===
# Bearer token required on all /api routes. Without it the API only serves
# loopback (localhost) clients and rejects everything else with a 503.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
FABOPS_API_TOKEN=

# === Debug endpoints (OPTIONAL) ===
# Set to 1 to enable /api/debug/* routes. Keep off in any shared deployment.
FABOPS_DEBUG=

# === AI Vision ===
# Any OpenAI-compatible endpoint works. With a local one no frame leaves your
# machine and OPENAI_API_KEY can stay empty.
#
# Local Ollama, e.g. the `ollama` service in docker-compose.yml:
#   ollama pull llava      (or llama3.2-vision, qwen2.5vl)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llava
# OPENAI_API_KEY=
#
# Hosted provider:
# Your OpenAI-compatible API key (or EAON, Groq, etc.)
OPENAI_API_KEY=sk-your-key-here
# Base URL for the API (OpenAI: https://api.openai.com/v1, EAON: https://api.eaon.dev/v1)
OPENAI_BASE_URL=https://api.eaon.dev/v1
# Model to use (e.g., gpt-4o-mini, gemini-3.1-flash-lite, llava)
OPENAI_MODEL=gemini-3.1-flash-lite

# === Twilio SMS Alerts (OPTIONAL) ===
# Get these at https://console.twilio.com
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_API_KEY_SID=your_api_key_sid
# TWILIO_API_KEY_SECRET=your_api_key_secret
# TWILIO_PHONE_NUMBER=+12345678900
# ALERT_PHONE_NUMBER=+12345678900

# === Rate Limiting (OPTIONAL) ===
# Max paid vision-API analyses per client per minute (default 10, 0 = off).
# ANALYZE_RATE_LIMIT_PER_MINUTE=10
