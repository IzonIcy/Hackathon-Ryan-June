# Backend env vars live in backend/.env.example — copy it:
#   cp backend/.env.example backend/.env
#
# docker compose reads this file for ${VAR} interpolation, which happens before
# backend/.env is loaded, so these two win over the backend file. Vision already
# defaults to the compose `ollama` service; uncomment to use a hosted provider.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
